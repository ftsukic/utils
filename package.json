{
  "name": "@ftsukic/utils",
  "type": "module",
  "version": "0.1.34",
  "description": "通用的工具库",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": "./*"
  },
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*",
        "./es/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "gen": "plop --plopfile ./scripts/gen.cjs --force",
    "del": "plop --plopfile ./scripts/del.cjs --force",
    "entry": "plop --plopfile ./scripts/entry.cjs --force",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "clean:es": "rimraf ./es",
    "clean:lib": "rimraf ./lib",
    "clean": "npm run clean:es && npm run clean:lib",
    "build": "npm run clean && tsup",
    "build:es": "npm run clean:es && tsc -p ./tsconfig-esm.json",
    "build:lib": "npm run clean:lib && tsc -p ./tsconfig.json",
    "build:tsc": "npm run entry && npm run build:es && npm run build:lib",
    "test": "jest",
    "coverage": "jest --coverage",
    "prerelease": "npm run entry && npm run docs",
    "release": "npm run build && dsc publish -t",
    "lint": "eslint \"src/**/*.{js,ts}\" --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftsukic/utils.git"
  },
  "keywords": [
    "daysnap",
    "utils",
    "tool"
  ],
  "files": [
    "lib",
    "es",
    "docs"
  ],
  "author": "ftsukic <ftsukic@gmail.com>",
  "sideEffects": false,
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ftsukic/utils/issues"
  },
  "homepage": "https://github.com/ftsukic/utils#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@daysnap/types": "^0.0.5",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "commitizen": "^4.3.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.8",
    "node-dir": "^0.1.17",
    "plop": "^4.0.5",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  }
}
